{
    "name": "yuriidiachuk/laravel-typed-i18n",
    "description": "Generate TypeScript types from Laravel translation files",
    "keywords": [
        "YuriiDiachuk",
        "laravel",
        "laravel-typed-i18n"
    ],
    "homepage": "https://github.com/yuriidiachuk/laravel-typed-i18n",
    "license": "MIT",
    "authors": [
        {
            "name": "Yurii Diachuk",
            "email": "yuriydyachuk91@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "nunomaduro/collision": "^8.0",
        "larastan/larastan": "^3.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpstan/phpstan": "^2.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "YuriiDiachuk\\LaravelTypedI18n\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YuriiDiachuk\\LaravelTypedI18n\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "YuriiDiachuk\\LaravelTypedI18n\\LaravelTypedI18nServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}